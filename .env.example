# Copy to .env for local development. Never commit the real .env.

# Required
REDIS_URL=

# Required in production — without it, accounts live in memory and are lost
# on every restart.
MONGODB_URI=
MONGODB_DB=central_redis

# Projects migrated from the old schema have no owner and stay hidden from
# every dashboard. Set this to an existing account's email to claim them at
# startup.
# LEGACY_OWNER_EMAIL=

# Optional
# ALLOW_MEMORY_STORE=false      # production refuses to boot without Mongo unless true
# SIGNUPS_ENABLED=true          # set false to close registration
# ENFORCE_LIMITS=false          # set true to reject requests over a limit
# SECURE_COOKIES=false          # defaults to true in production
# KEEP_ALIVE_ENABLED=true       # self-ping to stop Render's free tier sleeping
# BASE_URL=                     # public URL, used for keep-alive and code samples
# LIMIT_PROJECTS_PER_USER=10
# LIMIT_KEYS=10000
# LIMIT_BYTES=104857600
# LIMIT_REQUESTS_MONTH=1000000

# deploy.py only
# RENDER_API_KEY=
# GITHUB_REPO=

# Legacy: projects created before user accounts existed. Each one still
# authenticates that project's API calls.
# PROJECT_MY_APP=some-legacy-api-key
